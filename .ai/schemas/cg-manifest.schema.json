{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TsungmingLiu/seventeen-floor-neighbor/blob/main/.ai/schemas/cg-manifest.schema.json",
  "title": "Canonical CG Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_version",
    "lifecycle",
    "source_scene_ids",
    "style_contract",
    "entries"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "$ref": "#/$defs/nonEmpty" },
    "manifest_version": { "$ref": "#/$defs/nonEmpty" },
    "lifecycle": { "const": "CANONICAL" },
    "source_scene_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "style_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["style_id", "positive", "negative", "aspect_ratio", "output_count"],
      "properties": {
        "style_id": { "$ref": "#/$defs/nonEmpty" },
        "positive": { "$ref": "#/$defs/nonEmptyStringArray" },
        "negative": { "$ref": "#/$defs/nonEmptyStringArray" },
        "aspect_ratio": { "const": "16:9" },
        "output_count": { "const": 1 }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "referenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source_id", "expected_filename"],
      "properties": {
        "role": { "$ref": "#/$defs/nonEmpty" },
        "source_id": { "$ref": "#/$defs/nonEmpty" },
        "expected_filename": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character_id",
        "screen_side",
        "body_orientation",
        "pose",
        "gaze",
        "expression",
        "wardrobe_key",
        "held_objects",
        "reference_bindings"
      ],
      "properties": {
        "character_id": { "$ref": "#/$defs/nonEmpty" },
        "screen_side": { "enum": ["left", "center", "right", "offscreen"] },
        "body_orientation": { "$ref": "#/$defs/nonEmpty" },
        "pose": { "$ref": "#/$defs/nonEmpty" },
        "gaze": { "$ref": "#/$defs/nonEmpty" },
        "expression": { "$ref": "#/$defs/nonEmpty" },
        "wardrobe_key": { "$ref": "#/$defs/nonEmpty" },
        "held_objects": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "reference_bindings": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/referenceBinding" }
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location_id", "time_of_day", "weather", "lighting", "persistent_props", "reference_binding"],
      "properties": {
        "location_id": { "$ref": "#/$defs/nonEmpty" },
        "time_of_day": { "$ref": "#/$defs/nonEmpty" },
        "weather": { "$ref": "#/$defs/nonEmpty" },
        "lighting": { "$ref": "#/$defs/nonEmpty" },
        "persistent_props": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "reference_binding": {
          "oneOf": [
            { "$ref": "#/$defs/referenceBinding" },
            { "type": "null" }
          ]
        }
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_size", "angle", "pov", "axis_id", "camera_side", "lens_intent"],
      "properties": {
        "shot_size": { "enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close", "close", "extreme_close"] },
        "angle": { "$ref": "#/$defs/nonEmpty" },
        "pov": { "$ref": "#/$defs/nonEmpty" },
        "axis_id": { "$ref": "#/$defs/nonEmpty" },
        "camera_side": { "$ref": "#/$defs/nonEmpty" },
        "lens_intent": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_entry_id", "locked_fields", "allowed_changes"],
      "properties": {
        "previous_entry_id": {
          "type": ["string", "null"]
        },
        "locked_fields": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "allowed_changes": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["focus", "dialogue_safe_zone", "framing_notes"],
      "properties": {
        "focus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 100 },
            "y": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "dialogue_safe_zone": { "$ref": "#/$defs/nonEmpty" },
        "framing_notes": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "fresh_session_required", "no_unrelated_images_allowed", "accepted_base_asset_id", "attachments"],
      "properties": {
        "mode": { "enum": ["references_required", "edit_from_accepted_base", "none"] },
        "fresh_session_required": { "type": "boolean" },
        "no_unrelated_images_allowed": { "type": "boolean" },
        "accepted_base_asset_id": { "type": ["string", "null"] },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "source_id", "expected_filename", "pixels_must_be_visible"],
            "properties": {
              "role": { "$ref": "#/$defs/nonEmpty" },
              "source_id": { "$ref": "#/$defs/nonEmpty" },
              "expected_filename": { "$ref": "#/$defs/nonEmpty" },
              "pixels_must_be_visible": { "const": true }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_asset_id", "logical_asset_id", "master_filename", "quantity"],
      "properties": {
        "canonical_asset_id": { "$ref": "#/$defs/nonEmpty" },
        "logical_asset_id": { "$ref": "#/$defs/nonEmpty" },
        "master_filename": { "$ref": "#/$defs/nonEmpty" },
        "quantity": { "const": 1 }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "scene_id",
        "source_scene",
        "status",
        "cg_class",
        "beat_range",
        "narrative",
        "characters",
        "environment",
        "camera",
        "continuity",
        "composition",
        "render_constraints",
        "reference_transport",
        "output",
        "acceptance"
      ],
      "properties": {
        "entry_id": { "$ref": "#/$defs/nonEmpty" },
        "scene_id": { "$ref": "#/$defs/nonEmpty" },
        "source_scene": { "$ref": "#/$defs/nonEmpty" },
        "status": { "enum": ["planned", "render_ready", "candidate", "accepted", "rejected", "blocked"] },
        "cg_class": { "enum": ["background_cg", "dialogue_cg", "reaction_cg", "event_cg", "cg_sequence_keyframe"] },
        "sequence_id": { "type": ["string", "null"] },
        "known_issues": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "beat_range": { "$ref": "#/$defs/nonEmpty" },
        "narrative": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "must_show", "must_not_imply"],
          "properties": {
            "purpose": { "$ref": "#/$defs/nonEmpty" },
            "must_show": { "$ref": "#/$defs/nonEmptyStringArray" },
            "must_not_imply": { "$ref": "#/$defs/nonEmptyStringArray" }
          }
        },
        "characters": { "type": "array", "items": { "$ref": "#/$defs/character" } },
        "environment": { "$ref": "#/$defs/environment" },
        "camera": { "$ref": "#/$defs/camera" },
        "continuity": { "$ref": "#/$defs/continuity" },
        "composition": { "$ref": "#/$defs/composition" },
        "render_constraints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude", "text_policy"],
          "properties": {
            "include": { "$ref": "#/$defs/nonEmptyStringArray" },
            "exclude": { "$ref": "#/$defs/nonEmptyStringArray" },
            "text_policy": { "$ref": "#/$defs/nonEmpty" }
          }
        },
        "reference_transport": { "$ref": "#/$defs/transport" },
        "output": { "$ref": "#/$defs/output" },
        "acceptance": { "$ref": "#/$defs/nonEmptyStringArray" }
      },
      "allOf": [
        {
          "if": { "required": ["known_issues"] },
          "then": {
            "properties": { "status": { "const": "accepted" } }
          }
        },
        {
          "if": {
            "properties": { "cg_class": { "const": "background_cg" } },
            "required": ["cg_class"]
          },
          "then": {
            "properties": {
              "characters": { "maxItems": 0 },
              "reference_transport": {
                "properties": { "mode": { "enum": ["references_required", "none"] } }
              }
            }
          },
          "else": {
            "properties": { "characters": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "cg_class": { "const": "reaction_cg" } },
            "required": ["cg_class"]
          },
          "then": {
            "properties": {
              "continuity": {
                "properties": {
                  "previous_entry_id": { "type": "string", "minLength": 1 },
                  "locked_fields": { "minItems": 1 },
                  "allowed_changes": { "minItems": 1 }
                }
              },
              "reference_transport": {
                "properties": {
                  "mode": { "const": "edit_from_accepted_base" },
                  "accepted_base_asset_id": { "type": "string", "minLength": 1 },
                  "attachments": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "cg_class": { "enum": ["dialogue_cg", "event_cg"] } },
            "required": ["cg_class"]
          },
          "then": {
            "properties": {
              "reference_transport": {
                "properties": {
                  "mode": { "const": "references_required" },
                  "accepted_base_asset_id": { "type": "null" },
                  "attachments": { "minItems": 1 }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference_transport": {
                "properties": { "mode": { "const": "references_required" } },
                "required": ["mode"]
              }
            }
          },
          "then": {
            "properties": {
              "reference_transport": {
                "properties": { "attachments": { "minItems": 1 } }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "reference_transport": {
                "properties": { "mode": { "const": "none" } },
                "required": ["mode"]
              }
            }
          },
          "then": {
            "properties": {
              "reference_transport": {
                "properties": {
                  "accepted_base_asset_id": { "type": "null" },
                  "attachments": { "maxItems": 0 }
                }
              }
            }
          }
        }
      ]
    }
  }
}
