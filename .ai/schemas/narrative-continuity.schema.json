{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TsungmingLiu/seventeen-floor-neighbor/blob/main/.ai/schemas/narrative-continuity.schema.json",
  "title": "Narrative Continuity Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scene_id",
    "lifecycle",
    "source_scene",
    "entry_state",
    "scene_function",
    "character_intent",
    "player_information_gain",
    "emotional_arc",
    "required_payoffs",
    "exit_state",
    "must_not",
    "implementation_mapping"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "scene_id": { "$ref": "#/$defs/nonEmpty" },
    "lifecycle": { "const": "CANONICAL" },
    "source_scene": { "$ref": "#/$defs/nonEmpty" },
    "entry_state": { "$ref": "#/$defs/state" },
    "scene_function": { "$ref": "#/$defs/nonEmptyStringArray" },
    "character_intent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_id", "intent"],
        "properties": {
          "character_id": { "$ref": "#/$defs/nonEmpty" },
          "intent": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "player_information_gain": { "$ref": "#/$defs/nonEmptyStringArray" },
    "emotional_arc": { "$ref": "#/$defs/nonEmptyStringArray" },
    "required_payoffs": { "$ref": "#/$defs/nonEmptyStringArray" },
    "exit_state": { "$ref": "#/$defs/state" },
    "must_not": { "$ref": "#/$defs/nonEmptyStringArray" },
    "implementation_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_only", "flags"],
      "properties": {
        "runtime_only": { "const": true },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "toward", "label", "constraints"],
      "properties": {
        "subject": { "$ref": "#/$defs/nonEmpty" },
        "toward": { "$ref": "#/$defs/nonEmpty" },
        "label": { "$ref": "#/$defs/nonEmpty" },
        "constraints": { "$ref": "#/$defs/nonEmptyStringArray" }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["holder", "knows", "does_not_know"],
      "properties": {
        "holder": { "$ref": "#/$defs/nonEmpty" },
        "knows": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } },
        "does_not_know": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationships", "knowledge", "constraints"],
      "properties": {
        "relationships": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relationship" }
        },
        "knowledge": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/knowledge" }
        },
        "constraints": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    }
  }
}
