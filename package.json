{
  "name": "seventeen-floor-neighbor",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "validate": "node tools/check-session-cache.mjs && node tools/validate-content.mjs && node tools/validate-production-contracts.mjs",
    "validate:final": "node tools/validate-content.mjs --final-visuals && node tools/validate-production-contracts.mjs",
    "production:storage:check": "node tools/production-storage.mjs",
    "production:validate": "node tools/validate-production-contracts.mjs",
    "production:review": "node tools/production-review.mjs",
    "production:impact": "node tools/production-impact.mjs",
    "production:run:check": "node tools/verify-production-run.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/preview-server.mjs --dev --port 4173",
    "preview": "node tools/preview-server.mjs --preview --port 4173",
    "preview:smoke": "node tools/preview-server.mjs --smoke --port 4173",
    "codespace:accept": "node tools/codespace-accept.mjs",
    "codespace:review": "node tools/codespace-accept.mjs --public-review",
    "assets:check": "node tools/check-assets.mjs",
    "assets:build": "node tools/build-assets.mjs",
    "assets:plan": "node tools/asset-plan.mjs",
    "cg:packet": "node tools/render-cg-packets.mjs",
    "context": "node tools/context.mjs",
    "cg:references": "node tools/character-references.mjs",
    "cg:wardrobe": "node tools/wardrobe-look-references.mjs",
    "scratch:check": "node tools/check-session-cache.mjs",
    "context:poc": "node tools/compile-review-context.mjs",
    "context:benchmark": "node tools/benchmark-review-context.mjs",
    "context:delta:poc": "node tools/delta-review-poc.mjs",
    "context:preflight": "node tools/preflight-review.mjs",
    "context:preflight:benchmark": "node tools/benchmark-preflight.mjs",
    "context:observe": "node tools/observe-review-dispatch.mjs",
    "production:integration:check": "node tools/production-integration-check.mjs",
    "assets:coverage": "node tools/asset-coverage.mjs",
    "validate:release": "npm run validate:final && node tools/asset-coverage.mjs --strict",
    "production:preflight": "node tools/production-preflight.mjs",
    "production:handoff": "node tools/production-handoff.mjs"
  }
}
