      "speaker": "你",
      "text": "",
      "chapter": 1,
      "visual": {
        "mode": "cg",
        "asset": "cg.opening-ch1.com01b.01"
      },
      "choices": [
        {
          "id": "com01b_browse_shops",
          "text": "這附近有沒有適合一個人慢慢逛的店？",
          "next": "com01b_browse_shops"
        },
        {
          "id": "com01b_find_books",
          "text": "附近有能翻設定集的書店嗎？週末想去找一本書。",
          "next": "com01b_find_books"
        },
        {
          "id": "com01b_food_or_coffee",
          "text": "想找個地方吃點東西、喝杯咖啡，再順路逛逛。這附近有方向嗎？",
          "next": "com01b_food_or_coffee"
        }
      ]
    },
